{
  "name": "@inntris/highnote-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Reference Highnote Collaborative Authorization adapter for Inntris organisational authority decisions and portable evidence.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "demo": "tsx scripts/demo.ts",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "verify:evidence": "tsx scripts/verify-evidence.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run scan:secrets"
  },
  "dependencies": {
    "canonicalize": "3.0.0",
    "fastify": "5.11.3",
    "fflate": "0.8.2",
    "prom-client": "15.1.3",
    "tweetnacl": "1.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/node": "24.2.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "tsx": "4.23.11",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vitest": "3.2.7"
  }
}
