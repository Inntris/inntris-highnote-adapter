# Highnote request authentication. Never commit real endpoint secrets.
HIGHNOTE_SIGNING_SECRETS=replace-with-highnote-endpoint-secret
HIGHNOTE_SIGNATURE_ENCODING=hex
HIGHNOTE_MAX_SIGNATURE_AGE_MS=300000
HIGHNOTE_MAX_FUTURE_SKEW_MS=30000

# Authority implementation. `local` preserves the reference mandate and
# portable-evidence path below. `inntris_core` uses Inntris Core as the only
# spend-policy authority and requires the Core settings later in this file.
AUTHORITY_MODE=local

# Inntris decision signing. Use a managed secret source in deployed environments.
INNTRIS_SIGNING_KEY_ID=replace-with-published-key-id
INNTRIS_SIGNING_SEED_BASE64URL=replace-with-32-byte-base64url-seed

# Pre-warmed mandate snapshot loaded once at startup.
MANDATE_SNAPSHOT_PATH=./config/mandates.test.json
PUBLIC_ADAPTER_URL=https://adapter.example.test/v1/highnote/collaborative-authorization

# Optional customer Collaborative Authorization pass-through endpoint.
DOWNSTREAM_AUTHORIZATION_URL=
DOWNSTREAM_TIMEOUT_MS=650
DOWNSTREAM_FAILURE_POLICY=deny

# Inntris Core authority mode. The private key is the registered agent's raw
# 32-byte Ed25519 seed in canonical standard base64. It is not the local
# INNTRIS_SIGNING_SEED_BASE64URL identity above. Keep it only in the deployment
# secret store. The expected fingerprint is lowercase SHA-256 over the derived
# raw 32-byte public key and prevents starting with the wrong seed.
INNTRIS_API_URL=https://api.inntris.com
INNTRIS_AGENT_ID=replace-with-registered-agent-uuid
INNTRIS_PRIVATE_KEY_B64=replace-with-32-byte-standard-base64-seed
INNTRIS_PUBLIC_KEY_FINGERPRINT=replace-with-64-character-lowercase-hex-fingerprint
HIGHNOTE_CARD_ID=replace-with-bound-highnote-card-id

# One shared deadline for the sequential /verify and /verify-token flow. It
# must remain below Highnote's 2000 ms callback budget.
INNTRIS_TIMEOUT_MS=1200
INNTRIS_RECEIPT_BASE_URL=https://www.inntris.com/verify/

# How a failure raised after a request is authenticated reaches Highnote.
# decline   returns a 2xx decline and keeps the adapter an enforcement control.
# stand_in  returns a non-2xx status and hands the outcome to the Highnote
#           card product stand-in setting, which may be configured to approve.
AUTHORIZATION_FAILURE_POLICY=decline

# Service settings.
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
EVIDENCE_OUTPUT_DIRECTORY=./evidence-output
IDEMPOTENCY_MAX_ENTRIES=10000
IDEMPOTENCY_TTL_MS=600000
NODE_ENV=development
