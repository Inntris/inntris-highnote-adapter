# Highnote request authentication. Never commit real endpoint secrets.
HIGHNOTE_SIGNING_SECRETS=replace-with-highnote-endpoint-secret
HIGHNOTE_SIGNATURE_ENCODING=hex
HIGHNOTE_MAX_SIGNATURE_AGE_MS=300000
HIGHNOTE_MAX_FUTURE_SKEW_MS=30000

# Inntris decision signing. Use a managed secret source in deployed environments.
INNTRIS_SIGNING_KEY_ID=replace-with-published-key-id
INNTRIS_SIGNING_SEED_BASE64URL=replace-with-32-byte-base64url-seed

# Pre-warmed mandate snapshot loaded once at startup.
MANDATE_SNAPSHOT_PATH=./config/mandates.test.json
PUBLIC_ADAPTER_URL=https://adapter.example.test/v1/highnote/collaborative-authorization

# Optional customer Collaborative Authorization pass-through endpoint.
DOWNSTREAM_AUTHORIZATION_URL=
DOWNSTREAM_TIMEOUT_MS=650
DOWNSTREAM_FAILURE_POLICY=deny

# Service settings.
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
EVIDENCE_OUTPUT_DIRECTORY=./evidence-output
IDEMPOTENCY_MAX_ENTRIES=10000
IDEMPOTENCY_TTL_MS=600000
NODE_ENV=development
